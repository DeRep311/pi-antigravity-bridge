  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.5.1",
    "@earendil-works/pi-coding-agent": ">=1.5.1"
  },
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeRep311/pi-antigravity-bridge.git"
  }
