  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "gemini",
    "antigravity",
    "agy",
    "acp"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
